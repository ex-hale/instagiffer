{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Instagiffer",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/instagiffer/__init__.py",
      "args": ["--debug"],
      "python": "${command:python.interpreterPath}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Py: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/src",
      "python": "${command:python.interpreterPath}",
      "env": {"PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/src"},
      "justMyCode": false
    }
  ]
}
